# GROQ_API_KEY: Required for Groq AI API calls (llama-3.3-70b-versatile, etc.).
# Obtain from https://console.groq.com/keys
# Never expose this key on the client side.
GROQ_API_KEY="gsk_your_groq_api_key_here"

# GROQ_MODEL: Default model for Groq completions (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL="llama-3.3-70b-versatile"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
